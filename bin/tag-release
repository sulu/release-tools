#!/usr/bin/env php
<?php

use Symfony\Component\Console\Input\InputArgument;
use Symfony\Component\Console\Input\InputInterface;
use Symfony\Component\Console\Input\InputOption;
use Symfony\Component\Console\Output\OutputInterface;
use Symfony\Component\Console\SingleCommandApplication;
use Symfony\Component\Console\Style\SymfonyStyle;
use Symfony\Component\Filesystem\Filesystem;
use Symfony\Component\Process\Process;

require __DIR__.'/../vendor/autoload.php';

function runCommand(string $command, ?string $directory = null, int $timeout = 60): string
{
    $process = Process::fromShellCommandline($command, $directory);
    $process->setTimeout($timeout);
    $process->run();

    if (!$process->isSuccessful()) {
        throw new \RuntimeException(\sprintf(
            'Command "%s" failed with exit code %s:%s%s',
            $command,
            $process->getExitCode(),
            \PHP_EOL,
            \trim($process->getErrorOutput() ?: $process->getOutput())
        ));
    }

    return $process->getOutput();
}

function cloneRepository(SymfonyStyle $ui, string $directory, string $branch, string $repository): void
{
    $filesystem = new Filesystem();
    if ($filesystem->exists($directory)) {
        $filesystem->remove($directory);
    }

    $ui->section(\sprintf('Cloning repository "%s":', $repository));
    runCommand(
        \sprintf(
            'git clone git@github.com:%s.git --branch %s %s',
            $repository,
            $branch,
            $directory
        ),
        null,
        3600 // increase timeout as default timeout is 60 seconds in symfony process component
    );

    $ui->text(\sprintf('Finished cloning repository "%s" into "%s".', $repository, $directory));
}

function assertHeadIsNotTagged(string $directory, string $branch): void
{
    $tags = \trim(runCommand('git tag --points-at HEAD', $directory));

    if ('' !== $tags) {
        throw new \RuntimeException(\sprintf(
            'The head of branch "%s" is already tagged with "%s", there is nothing new to release.',
            $branch,
            \str_replace(\PHP_EOL, ', ', $tags)
        ));
    }
}

function assertTagDoesNotExist(string $directory, string $tag): void
{
    if ('' !== \trim(runCommand(\sprintf('git tag --list %s', \escapeshellarg($tag)), $directory))
        || '' !== \trim(runCommand(\sprintf('git ls-remote --tags origin %s', \escapeshellarg('refs/tags/' . $tag)), $directory))
    ) {
        throw new \RuntimeException(\sprintf('The tag "%s" already exists.', $tag));
    }
}

function isMerged(string $directory, string $commit, string $into = 'HEAD'): bool
{
    $process = Process::fromShellCommandline(\sprintf('git merge-base --is-ancestor %s %s', \escapeshellarg($commit), \escapeshellarg($into)), $directory);
    $process->run();

    return $process->isSuccessful();
}

function isReleasedWith(string $directory, string $version, string $tag): bool
{
    foreach ([$version, 'v' . $version] as $candidate) {
        $process = Process::fromShellCommandline(\sprintf('git rev-parse -q --verify %s', \escapeshellarg('refs/tags/' . $candidate)), $directory);
        $process->run();

        if ($process->isSuccessful()) {
            return isMerged($directory, $candidate, $tag);
        }
    }

    return false;
}

function isDevConstraint(string $constraint): bool
{
    foreach (\preg_split('/\s*\|\|?\s*/', \trim($constraint)) as $alternative) {
        if (!\preg_match('/(@dev|-dev)$|^dev-/', \trim($alternative))) {
            return false;
        }
    }

    return true;
}

/**
 * @return string[]
 */
function findDevDependencies(string $directory): array
{
    $composer = \json_decode(\file_get_contents($directory . '/composer.json'), true);

    $problems = [];
    foreach (['require', 'require-dev'] as $section) {
        foreach ($composer[$section] ?? [] as $package => $constraint) {
            if (isDevConstraint($constraint)) {
                $problems[] = \sprintf('The composer.json requires "%s": "%s" in "%s", which only allows a development version.', $package, $constraint, $section);
            }
        }
    }

    return $problems;
}

/**
 * Finds upgrade notes added under a version which the previous tag already contains and sections of versions which are not released yet.
 *
 * @return string[]
 */
function findUpgradeNoteProblems(string $directory, ?string $previousTag, string $newTag): array
{
    $problems = [];
    // the section of a release candidate is the one of the release, so compare without the suffix
    $new = \preg_replace('/-.*$/', '', \ltrim($newTag, 'v'));

    foreach (\glob($directory . '/UPGRADE-*.x.md') as $path) {
        $file = \basename($path);
        $lines = \file($path, \FILE_IGNORE_NEW_LINES);

        $headings = [];
        foreach ($lines as $index => $line) {
            if (\preg_match('/^## (.+)$/', $line, $heading)) {
                $headings[$index + 1] = $heading[1];
            }
        }

        foreach ($headings as $line => $heading) {
            $isVersion = \preg_match('/^v?(\d+\.\d+\.\d+\S*)/', $heading, $version);
            if (($isVersion && \version_compare($version[1], $new, '>')) || \preg_match('/\bunreleased\b|-dev\b|\bdev-/i', $heading)) {
                $problems[] = \sprintf('%s:%d has the section "%s", which is not released yet.', $file, $line, $heading);
            }
        }

        if (!$previousTag) {
            continue;
        }

        $diff = runCommand(\sprintf('git diff --unified=0 %s HEAD -- %s', \escapeshellarg($previousTag), \escapeshellarg($file)), $directory);
        $reported = [];
        foreach (\explode(\PHP_EOL, $diff) as $diffLine) {
            if (!\preg_match('/^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@/', $diffLine, $range) || (isset($range[2]) && '0' === $range[2])) {
                continue;
            }

            $heading = null;
            foreach ($headings as $line => $text) {
                if ($line <= (int) $range[1]) {
                    $heading = $text;
                }
            }

            if (null !== $heading
                && !isset($reported[$heading])
                && \preg_match('/^v?(\d+\.\d+\.\d+\S*)/', $heading, $version)
                && isReleasedWith($directory, $version[1], $previousTag)
            ) {
                $reported[$heading] = true;
                $problems[] = \sprintf('%s:%d was changed under the section "%s", which is already part of "%s".', $file, $range[1], $heading, $previousTag);
            }
        }
    }

    return $problems;
}

function findSuluConstraintProblem(string $directory, string $newTag): ?string
{
    $version = \ltrim($newTag, 'v');
    if (!\preg_match('/^\d+\.\d+\.\d+$/', $version)) {
        return null;
    }

    $composer = \json_decode(\file_get_contents($directory . '/composer.json'), true);
    $constraint = $composer['require']['sulu/sulu'] ?? null;

    if ('~' . $version === $constraint) {
        return null;
    }

    return \sprintf('The composer.json requires "sulu/sulu": "%s", expected "~%s".', $constraint ?? 'nothing', $version);
}

/**
 * @return string[]
 */
function findReleaseProblems(string $directory, string $repository, ?string $previousTag, string $newTag): array
{
    $problems = [];

    if ($previousTag && !isMerged($directory, $previousTag)) {
        $problems[] = \sprintf('The previous tag "%s" is not merged into this branch.', $previousTag);
    }

    $problems = \array_merge($problems, findDevDependencies($directory), findUpgradeNoteProblems($directory, $previousTag, $newTag));

    if ('sulu/skeleton' === $repository && $problem = findSuluConstraintProblem($directory, $newTag)) {
        $problems[] = $problem;
    }

    return $problems;
}

function isVersionBranch(string $branch): bool
{
    return (bool) \preg_match('/^\d+(\.\d+)?$/', $branch);
}

function belongsToBranch(string $tag, string $branch): bool
{
    return 0 === \strpos(\ltrim($tag, 'v'), $branch . '.');
}

function getNewTag(SymfonyStyle $ui, string $directory, string $branch, ?string $previousTag): ?string
{
    $newTag = null;
    if ($previousTag && isVersionBranch($branch) && !belongsToBranch($previousTag, $branch)) {
        // first release of a new version, e.g. 3.1.0 after 3.0.12
        $newTag = (0 === \strpos($previousTag, 'v') ? 'v' : '') . $branch . '.0';
    } elseif ($previousTag) {
        $parts = \explode('.', $previousTag, 3);

        $newTag = $parts[0] . '.' . $parts[1] . '.' . (++$parts[2]);
    }

    do {
        $newTag = $ui->ask(\sprintf('What is the new tag for branch "%s"?', $branch), $newTag);
    } while(!$newTag);

    return $newTag;
}

function getPreviousTag(SymfonyStyle $ui, string $directory, string $branch): ?string
{
    $tags = \explode(\PHP_EOL, \trim(runCommand('git tag --list', $directory)));

    $equalTags = [];
    foreach ($tags as $tag) {
        if (belongsToBranch($tag, $branch)) {
            $equalTags[] = $tag;
        }
    }

    if (empty($equalTags) && isVersionBranch($branch)) {
        // first release of a new version, e.g. 3.1: the previous tag is the latest one below it
        foreach ($tags as $tag) {
            if (\version_compare(\ltrim($tag, 'v'), $branch . '.0-dev', '<')) {
                $equalTags[] = $tag;
            }
        }
    }

    if (empty($equalTags)) {
        $equalTags = $tags;
    }

    $previousTag = null;
    foreach ($equalTags as $equalTag) {
        if ($previousTag === null || version_compare(trim($previousTag, 'v'), trim($equalTag, 'v'), '<')) {
            $previousTag = $equalTag;
        }
    }

    if ($previousTag) {
        do {
            $previousTag = $ui->ask(\sprintf('What is the previous tagged version?'), $previousTag);
        } while(!$previousTag);
    }

    return $previousTag;
}

function setTag(SymfonyStyle $ui, string $directory, string $branch, $tag): void
{
    $ui->section(\sprintf('Set tag "%s" on %s:', $tag, $branch));
    runCommand(\sprintf('git tag %s', \escapeshellarg($tag)), $directory);
    $ui->text(\sprintf('Use tag "%s".', $tag));
}

function pushTag(SymfonyStyle $ui, string $directory, string $branch, $tag): void
{
    $ui->section(\sprintf('Push tag "%s" on %s:', $tag, $branch));
    runCommand(\sprintf('git push origin %s', \escapeshellarg($tag)), $directory, 300);
    $ui->success(\sprintf('Pushed tag "%s".', $tag));
}

(new SingleCommandApplication())
    ->setVersion('1.0.0')
    ->setName('Release Script')
    ->addArgument('repository', InputArgument::REQUIRED)
    ->addArgument('branch', InputArgument::REQUIRED)
    ->addOption('--dry-run', null, InputOption::VALUE_NONE)
    ->addOption('--yes', null, InputOption::VALUE_NONE, 'Accept the default answer of every question, required when no one can answer them')
    ->setCode(function (InputInterface $input, OutputInterface $output) {
        $ui = new SymfonyStyle($input, $output);
        $repository = $input->getArgument('repository');
        $branch = $input->getArgument('branch');
        $dryRun = $input->getOption('dry-run');

        if (!$input->isInteractive() && !$input->getOption('yes')) {
            throw new \RuntimeException('Without a terminal every question would be answered with its default. Run the command in a terminal or pass --yes to accept the defaults.');
        }

        $ui->section('Configuration');

        if ('y' !== \strtolower($ui->ask(\sprintf('Create tags for branch "%s"?', $branch), 'y'))) {
            $ui->text('Canceled by user.');

            return 0;
        }

        $ui->text(\sprintf('Start tagging "%s" branch.', $branch));

        $directory = dirname(__DIR__) . '/var/releases';
        $suluDirectory = $directory . '/' . $repository . '/' . $branch;

        cloneRepository($ui, $suluDirectory, $branch, $repository);
        assertHeadIsNotTagged($suluDirectory, $branch);

        $ui->section(\sprintf('Tagging branch %s:', $branch));
        $previousTag = getPreviousTag($ui, $suluDirectory, $branch);
        $newTag = getNewTag($ui, $suluDirectory, $branch, $previousTag);
        assertTagDoesNotExist($suluDirectory, $newTag);

        $problems = findReleaseProblems($suluDirectory, $repository, $previousTag, $newTag);
        if ($problems) {
            $ui->warning($problems);

            if ('y' !== \strtolower($ui->ask('Continue anyway?', 'n'))) {
                $ui->text('Canceled because of the problems above.');

                return 1;
            }
        }

        if ($repository === 'sulu/skeleton') {
            if ('y' !== \strtolower($ui->ask(\sprintf('Is the "public/build/admin" directory up to date?'), 'y'))) {
                $ui->text('Canceled by user.');

                return 0;
            }
        }

        setTag($ui, $suluDirectory, $branch, $newTag);

        if ('y' !== \strtolower($ui->ask(\sprintf('Push tag "%s" on "%s" to remote?', $newTag, $branch), 'y'))) {
            $ui->text('Canceled by user.');

            return 0;
        }

        $ui->info(\sprintf(
            'To generate the changelog run:' . \PHP_EOL . \PHP_EOL . 'bin/generate-changelog %s %s...%s',
            $repository,
            $previousTag,
            $dryRun ? $branch : $newTag
        ));

        if ($dryRun) {
            $ui->writeln('Tag created but not pushed.');

            return 0;
        }

        pushTag($ui, $suluDirectory, $branch, $newTag);

        return 0;
    })->run();
